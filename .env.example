VITE_BASE_PATH=/mister-molkky/
NODE_ENV=production

# Optional: real-time collaborative match tracking via Supabase. Leave empty
# to keep the app fully offline (the "live" feature is hidden in that case).
# See docs/live-supabase.md for the SQL to apply on your Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: error monitoring via Sentry. Leave empty to disable (no-op, the
# @sentry/react peer is never loaded). Set your DSN to activate reporting.
VITE_SENTRY_DSN=

# Clé de projet PostHog (`phc_…`), nuage EUROPÉEN — la MÊME pour tout le parc :
# un seul projet, les applications distinguées dedans par `app_name`, que le
# socle déduit du chemin de base. Publique par conception (elle est dans le
# bundle). Absente, le bandeau de consentement ne rend rien et rien n'est
# mesuré — c'est le seul interrupteur.
VITE_POSTHOG_KEY=
